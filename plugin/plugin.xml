<?xml version="1.0" encoding="UTF-8"?>
<plugin id="com.mcp.visualparadigm"
        name=""
        description="Live Sync and One-Click Import bridge between MCP AI agents and Visual Paradigm"
        version="1.0.0"
        provider-name="Larom4ik"
        class="com.mcp.visualparadigm.MCPPlugin">

    <runtime>
        <library path="lib/mcp-plugin.jar"/>
    </runtime>

    <actionSets>
        <actionSet id="com.mcp.visualparadigm.actionSet">
            <menu id="com.mcp.visualparadigm.menu"
                  label="MCP"
                  menuPath="/#"
                  mnemonic="M">
            </menu>

            <action id="com.mcp.visualparadigm.actions.ImportXMIAction"
                    label="Import XMI"
                    tooltip="Select and import XMI file generated by MCP Visual Paradigm"
                    icon="icons/import_xmi.png"
                    menuPath="com.mcp.visualparadigm.menu/#"
                    toolbarPath="Plugins"
                    style="normal">
                <actionController class="com.mcp.visualparadigm.actions.ImportXMIActionController"/>
            </action>

            <separator id="com.mcp.visualparadigm.separator1"
                       menuPath="com.mcp.visualparadigm.menu/#"/>

            <action id="com.mcp.visualparadigm.actions.StartServerAction"
                    label="Connect"
                    tooltip="Start Live Sync server on 127.0.0.1:19842"
                    icon="icons/connect.png"
                    menuPath="com.mcp.visualparadigm.menu/#"
                    toolbarPath="Plugins"
                    style="normal">
                <actionController class="com.mcp.visualparadigm.actions.StartServerActionController"/>
            </action>

            <action id="com.mcp.visualparadigm.actions.StopServerAction"
                    label="Disconnect"
                    tooltip="Stop Live Sync background server"
                    icon="icons/disconnect.png"
                    menuPath="com.mcp.visualparadigm.menu/#"
                    toolbarPath="Plugins"
                    style="normal">
                <actionController class="com.mcp.visualparadigm.actions.StopServerActionController"/>
            </action>
        </actionSet>
    </actionSets>
</plugin>
