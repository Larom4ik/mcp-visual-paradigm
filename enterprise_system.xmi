					</xmi:Extension>
					<ownedComment xmi:type="uml:Comment" xmi:id="xmi_c21b989ee76b434caa11596d558ec385_comment" body="Order is being edited." />
				</subvertex>
				<subvertex xmi:type="uml:State" xmi:id="xmi_daffb28d9c8b414a90e5d7cd6d24935a" name="Paid">
					<entry xmi:type="uml:Activity" xmi:id="xmi_daffb28d9c8b414a90e5d7cd6d24935a_entry" name="send_receipt()" />
					<doActivity xmi:type="uml:Activity" xmi:id="xmi_daffb28d9c8b414a90e5d7cd6d24935a_do" name="reserve_inventory()" />
					<xmi:Extension extender="Visual Paradigm">
