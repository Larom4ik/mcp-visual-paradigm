		<ownedMember xmi:type="uml:StateMachine" xmi:id="sm_8e8a4e0c5e8e4728ab0189228f35eb7c" name="EnterpriseSystem_StateMachine">
			<region xmi:type="uml:Region" xmi:id="region_48002bcb7b404678b892d74ca030a386" name="DefaultRegion">
				<subvertex xmi:type="uml:Pseudostate" xmi:id="xmi_62f3ece031bf4e26a293b751377a5924" name="InitialState" kind="initial">
					<xmi:Extension extender="Visual Paradigm">
						<modelType value="Pseudostate" />
					</xmi:Extension>
				</subvertex>
				<subvertex xmi:type="uml:State" xmi:id="xmi_d581549f10e542fa9a184c031a3f11d5" name="Draft">
					<entry xmi:type="uml:Activity" xmi:id="xmi_d581549f10e542fa9a184c031a3f11d5_entry" name="init_draft()" />
					<exit xmi:type="uml:Activity" xmi:id="xmi_d581549f10e542fa9a184c031a3f11d5_exit" name="validate_items()" />
					<xmi:Extension extender="Visual Paradigm">
						<modelType value="State" />
						<documentation value="Order is being edited." />
					</xmi:Extension>
					<ownedComment xmi:type="uml:Comment" xmi:id="xmi_d581549f10e542fa9a184c031a3f11d5_comment" body="Order is being edited." />
				</subvertex>
				<subvertex xmi:type="uml:State" xmi:id="xmi_51ab154648ba4350921917c4879c5db2" name="Paid">
					<entry xmi:type="uml:Activity" xmi:id="xmi_51ab154648ba4350921917c4879c5db2_entry" name="send_receipt()" />
					<doActivity xmi:type="uml:Activity" xmi:id="xmi_51ab154648ba4350921917c4879c5db2_do" name="reserve_inventory()" />
					<xmi:Extension extender="Visual Paradigm">
						<modelType value="State" />
						<documentation value="Funds captured successfully." />
					</xmi:Extension>
					<ownedComment xmi:type="uml:Comment" xmi:id="xmi_51ab154648ba4350921917c4879c5db2_comment" body="Funds captured successfully." />
				</subvertex>
				<subvertex xmi:type="uml:State" xmi:id="xmi_41af818ab60243139cea4547b5dde7f1" name="Shipped">
					<doActivity xmi:type="uml:Activity" xmi:id="xmi_41af818ab60243139cea4547b5dde7f1_do" name="track_carrier()" />
					<xmi:Extension extender="Visual Paradigm">
						<modelType value="State" />
						<documentation value="Package is in transit with carrier." />
					</xmi:Extension>
					<ownedComment xmi:type="uml:Comment" xmi:id="xmi_41af818ab60243139cea4547b5dde7f1_comment" body="Package is in transit with carrier." />
				</subvertex>
				<subvertex xmi:type="uml:FinalState" xmi:id="xmi_df26465318934846a0773aef1b3dfc71" name="Completed">
					<xmi:Extension extender="Visual Paradigm">
						<modelType value="FinalState" />
					</xmi:Extension>
				</subvertex>
