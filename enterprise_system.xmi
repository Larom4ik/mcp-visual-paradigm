			<region xmi:type="uml:Region" xmi:id="region_1f301e31bfc54d0db2418920c87283c8" name="DefaultRegion">
				<subvertex xmi:type="uml:Pseudostate" xmi:id="xmi_b08037d2bbf548b3b5a190f204b9544b" name="InitialState" kind="initial">
