						<documentation value="Order is being edited." />
					</xmi:Extension>
					<ownedComment xmi:type="uml:Comment" xmi:id="xmi_6084cf2ba6bd4d0ea11c463c736f6ce9_comment" body="Order is being edited." />
				</subvertex>
				<subvertex xmi:type="uml:State" xmi:id="xmi_9fe024af1fc649059c6dd0e34bcfe2eb" name="Paid">
					<entry xmi:type="uml:Activity" xmi:id="xmi_9fe024af1fc649059c6dd0e34bcfe2eb_entry" name="send_receipt()" />
					<doActivity xmi:type="uml:Activity" xmi:id="xmi_9fe024af1fc649059c6dd0e34bcfe2eb_do" name="reserve_inventory()" />
