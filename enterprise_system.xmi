				</subvertex>
				<subvertex xmi:type="uml:State" xmi:id="xmi_1e9acfda069548b1b9a99860c10f4729" name="Draft">
					<entry xmi:type="uml:Activity" xmi:id="xmi_1e9acfda069548b1b9a99860c10f4729_entry" name="init_draft()" />
					<exit xmi:type="uml:Activity" xmi:id="xmi_1e9acfda069548b1b9a99860c10f4729_exit" name="validate_items()" />
					<xmi:Extension extender="Visual Paradigm">
						<modelType value="State" />
						<documentation value="Order is being edited." />
					</xmi:Extension>
					<ownedComment xmi:type="uml:Comment" xmi:id="xmi_1e9acfda069548b1b9a99860c10f4729_comment" body="Order is being edited." />
				</subvertex>
				<subvertex xmi:type="uml:State" xmi:id="xmi_0701f65ffd8049929bc315d3d68bf8f4" name="Paid">
					<entry xmi:type="uml:Activity" xmi:id="xmi_0701f65ffd8049929bc315d3d68bf8f4_entry" name="send_receipt()" />
					<doActivity xmi:type="uml:Activity" xmi:id="xmi_0701f65ffd8049929bc315d3d68bf8f4_do" name="reserve_inventory()" />
					<xmi:Extension extender="Visual Paradigm">
						<modelType value="State" />
						<documentation value="Funds captured successfully." />
					</xmi:Extension>
					<ownedComment xmi:type="uml:Comment" xmi:id="xmi_0701f65ffd8049929bc315d3d68bf8f4_comment" body="Funds captured successfully." />
				</subvertex>
				<subvertex xmi:type="uml:State" xmi:id="xmi_2d538a4406e34f8baae1e407902f55d8" name="Shipped">
					<doActivity xmi:type="uml:Activity" xmi:id="xmi_2d538a4406e34f8baae1e407902f55d8_do" name="track_carrier()" />
					<xmi:Extension extender="Visual Paradigm">
						<modelType value="State" />
						<documentation value="Package is in transit with carrier." />
					</xmi:Extension>
					<ownedComment xmi:type="uml:Comment" xmi:id="xmi_2d538a4406e34f8baae1e407902f55d8_comment" body="Package is in transit with carrier." />
				</subvertex>
				<subvertex xmi:type="uml:FinalState" xmi:id="xmi_95a4de0fda3f4f208803528be0859a4b" name="Completed">
					<xmi:Extension extender="Visual Paradigm">
						<modelType value="FinalState" />
