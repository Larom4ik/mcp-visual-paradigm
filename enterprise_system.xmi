				<subvertex xmi:type="uml:State" xmi:id="xmi_fcb17b6be237453c8d54e0a8447ce38b" name="Draft">
					<entry xmi:type="uml:Activity" xmi:id="xmi_fcb17b6be237453c8d54e0a8447ce38b_entry" name="init_draft()" />
					<exit xmi:type="uml:Activity" xmi:id="xmi_fcb17b6be237453c8d54e0a8447ce38b_exit" name="validate_items()" />
					<xmi:Extension extender="Visual Paradigm">
						<modelType value="State" />
						<documentation value="Order is being edited." />
					</xmi:Extension>
					<ownedComment xmi:type="uml:Comment" xmi:id="xmi_fcb17b6be237453c8d54e0a8447ce38b_comment" body="Order is being edited." />
				</subvertex>
				<subvertex xmi:type="uml:State" xmi:id="xmi_170eda9ab84c4ba1a4a7fc9f2866ca2c" name="Paid">
					<entry xmi:type="uml:Activity" xmi:id="xmi_170eda9ab84c4ba1a4a7fc9f2866ca2c_entry" name="send_receipt()" />
					<doActivity xmi:type="uml:Activity" xmi:id="xmi_170eda9ab84c4ba1a4a7fc9f2866ca2c_do" name="reserve_inventory()" />
					<xmi:Extension extender="Visual Paradigm">
						<modelType value="State" />
						<documentation value="Funds captured successfully." />
					</xmi:Extension>
					<ownedComment xmi:type="uml:Comment" xmi:id="xmi_170eda9ab84c4ba1a4a7fc9f2866ca2c_comment" body="Funds captured successfully." />
				</subvertex>
				<subvertex xmi:type="uml:State" xmi:id="xmi_c1dc2e7c1e024f56bd919caa2ff2147b" name="Shipped">
					<doActivity xmi:type="uml:Activity" xmi:id="xmi_c1dc2e7c1e024f56bd919caa2ff2147b_do" name="track_carrier()" />
					<xmi:Extension extender="Visual Paradigm">
						<modelType value="State" />
						<documentation value="Package is in transit with carrier." />
					</xmi:Extension>
					<ownedComment xmi:type="uml:Comment" xmi:id="xmi_c1dc2e7c1e024f56bd919caa2ff2147b_comment" body="Package is in transit with carrier." />
				</subvertex>
				<subvertex xmi:type="uml:FinalState" xmi:id="xmi_a691f8f41af745d6a42db449b8cb7dc6" name="Completed">
					<xmi:Extension extender="Visual Paradigm">
						<modelType value="FinalState" />
