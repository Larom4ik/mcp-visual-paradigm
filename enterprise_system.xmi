			<region xmi:type="uml:Region" xmi:id="region_5a1780f41f144e82ba2b8cdc975772f6" name="DefaultRegion">
				<subvertex xmi:type="uml:Pseudostate" xmi:id="xmi_6a928a49d1d64b7bac8de8b70f9156a2" name="InitialState" kind="initial">
