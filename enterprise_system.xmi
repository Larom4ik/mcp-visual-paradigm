		<ownedMember xmi:type="uml:StateMachine" xmi:id="sm_d2bf9aec4dfd40c3aa3142b1941e0070" name="EnterpriseSystem_StateMachine">
			<region xmi:type="uml:Region" xmi:id="region_be6951f983bc4d36b8620429929c9abf" name="DefaultRegion">
				<subvertex xmi:type="uml:Pseudostate" xmi:id="xmi_a71e47742e4c4ad8a8c6f5b021a363ac" name="InitialState" kind="initial">
