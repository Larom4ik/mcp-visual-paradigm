		<ownedMember xmi:type="uml:StateMachine" xmi:id="sm_f88c1e5ae3664cd88a03325c638320e4" name="EnterpriseSystem_StateMachine">
			<region xmi:type="uml:Region" xmi:id="region_b894aa7381624788af3f48533d16242e" name="DefaultRegion">
				<subvertex xmi:type="uml:Pseudostate" xmi:id="xmi_e1fe1d0ed6bd4ba297a476c494c394a1" name="InitialState" kind="initial">
					<xmi:Extension extender="Visual Paradigm">
						<modelType value="Pseudostate" />
