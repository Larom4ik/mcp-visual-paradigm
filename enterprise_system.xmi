				<subvertex xmi:type="uml:State" xmi:id="xmi_6084cf2ba6bd4d0ea11c463c736f6ce9" name="Draft">
					<entry xmi:type="uml:Activity" xmi:id="xmi_6084cf2ba6bd4d0ea11c463c736f6ce9_entry" name="init_draft()" />
					<exit xmi:type="uml:Activity" xmi:id="xmi_6084cf2ba6bd4d0ea11c463c736f6ce9_exit" name="validate_items()" />
					<xmi:Extension extender="Visual Paradigm">
