				<subvertex xmi:type="uml:State" xmi:id="xmi_c42d83f9a32b489aa43caa56aebb09c5" name="Draft">
					<entry xmi:type="uml:Activity" xmi:id="xmi_c42d83f9a32b489aa43caa56aebb09c5_entry" name="init_draft()" />
					<exit xmi:type="uml:Activity" xmi:id="xmi_c42d83f9a32b489aa43caa56aebb09c5_exit" name="validate_items()" />
					<xmi:Extension extender="Visual Paradigm">
						<modelType value="State" />
						<documentation value="Order is being edited." />
					</xmi:Extension>
					<ownedComment xmi:type="uml:Comment" xmi:id="xmi_c42d83f9a32b489aa43caa56aebb09c5_comment" body="Order is being edited." />
				</subvertex>
				<subvertex xmi:type="uml:State" xmi:id="xmi_7d076aef3e9f46df943f61e08c6b4705" name="Paid">
					<entry xmi:type="uml:Activity" xmi:id="xmi_7d076aef3e9f46df943f61e08c6b4705_entry" name="send_receipt()" />
					<doActivity xmi:type="uml:Activity" xmi:id="xmi_7d076aef3e9f46df943f61e08c6b4705_do" name="reserve_inventory()" />
					<xmi:Extension extender="Visual Paradigm">
