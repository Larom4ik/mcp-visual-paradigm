				</subvertex>
				<subvertex xmi:type="uml:State" xmi:id="xmi_a8fd470e65944a27bab8795b35d52436" name="Paid">
					<entry xmi:type="uml:Activity" xmi:id="xmi_a8fd470e65944a27bab8795b35d52436_entry" name="send_receipt()" />
					<doActivity xmi:type="uml:Activity" xmi:id="xmi_a8fd470e65944a27bab8795b35d52436_do" name="reserve_inventory()" />
