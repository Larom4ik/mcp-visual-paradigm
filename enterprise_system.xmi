					<ownedComment xmi:type="uml:Comment" xmi:id="xmi_0bb716a30a404f829100e1d4c214ecd1_comment" body="Order is being edited." />
				</subvertex>
				<subvertex xmi:type="uml:State" xmi:id="xmi_d3a8d744821f44b3bb22adef50a8c2cf" name="Paid">
					<entry xmi:type="uml:Activity" xmi:id="xmi_d3a8d744821f44b3bb22adef50a8c2cf_entry" name="send_receipt()" />
					<doActivity xmi:type="uml:Activity" xmi:id="xmi_d3a8d744821f44b3bb22adef50a8c2cf_do" name="reserve_inventory()" />
